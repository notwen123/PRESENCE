<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Buzz when a presence check appears while the phone is face-up on the desk. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Daily focus-appointment reminder (asked only when the user books a time). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-arm the appointment reminder and Presence Minutes sampling after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Held for ~1.5 s per Presence Minutes sample: screen-off sensors only report while the CPU is awake. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 11+ package visibility: the apps Urge Catcher can offer to watch (UrgeCatcher.kt). -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.twitter.android" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.reddit.frontpage" />
        <package android:name="in.mohalla.sharechat" />
        <package android:name="com.android.chrome" />
    </queries>

    <!-- Backups disabled: prefs hold the MWA auth token. -->
    <application
        android:name=".PresenceApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClockIn"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ClockIn.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".FocusAppointment$Reminder" android:exported="false" />
        <receiver android:name=".PresenceMinutes$Sampler" android:exported="false" />
        <receiver android:name=".PresenceMinutes$Boot" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".urge.InterceptActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.ClockIn" />
        <service
            android:name=".urge.UrgeCatcherService"
            android:exported="false"
            android:label="FACEDOWN Urge Catcher"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/urge_catcher" />
        </service>
    </application>

</manifest>
